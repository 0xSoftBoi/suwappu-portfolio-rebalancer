SUWAPPU_API_KEY=suwappu_sk_your_api_key_here
SUWAPPU_WALLET_ADDRESS=0xYourManagedWallet

# Per-action live defense in depth. Set below/equal to server-side wallet policy.
# MAX_REBALANCE_USD=1000

# Optional dust/churn guard. 0 preserves every planned leg above one cent.
# MIN_REBALANCE_USD=0

# Durable execution journal + drift-monitor history location.
# SUWAPPU_REBALANCER_STATE_DIR=/path/to/state

# Keep the newest N read-only drift snapshots (1..100000).
# SUWAPPU_REBALANCER_HISTORY_LIMIT=5000

# Direct Suwappu REST operation deadline (100..30000 ms; default 25000).
# SUWAPPU_OPERATION_TIMEOUT_MS=25000

# Metadata-only operation/outcome/duration/status events on stderr.
# SUWAPPU_API_EVENTS=0

# Optional API override (defaults to https://api.suwappu.bot).
# SUWAPPU_API_URL=https://api.suwappu.bot
