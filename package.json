{
  "name": "suwappu-portfolio-rebalancer",
  "version": "2.0.0",
  "private": true,
  "description": "Standalone treasury drift monitor and controlled Suwappu portfolio rebalancer",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": {
    "suwappu-rebalance": "src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "check": "bun src/index.ts check",
    "rebalance": "bun src/index.ts rebalance",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "verify": "bun run typecheck && bun test && bun run build && bun audit --audit-level=high"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xSoftBoi/suwappu-portfolio-rebalancer"
  },
  "homepage": "https://github.com/0xSoftBoi/suwappu-portfolio-rebalancer#readme",
  "keywords": ["suwappu", "portfolio", "rebalancer", "defi", "cross-chain", "trading"],
  "author": "Suwappu",
  "dependencies": {
    "@suwappu/sdk": "^0.4.0",
    "chalk": "^6.0.0",
    "commander": "^12.0.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.10",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
